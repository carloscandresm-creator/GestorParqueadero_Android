<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ==================== LOGIN ==================== -->

    <LinearLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:visibility="visible">

        <!-- Encabezado verde -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#4CAF50"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="180dp"
                android:layout_height="140dp"
                android:src="@drawable/logo1"
                android:contentDescription="Logo ParkQR" />

        </LinearLayout>


        <!-- Formulario de inicio de sesión -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#F5F5F5">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio de sesión"
                android:textSize="18sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />


            <EditText
                android:id="@+id/etCedula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cédula"
                android:inputType="number"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />


            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />


            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"
                android:padding="12dp" />


            <TextView
                android:id="@+id/tvMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="#E53935"
                android:layout_marginTop="10dp" />


            <!-- Opciones inferiores -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvOlvido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Olvidó su contraseña?"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:padding="6dp" />


                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#999999"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />


                <TextView
                    android:id="@+id/tvRegistrarse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrarse"
                    android:textColor="#555555"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="6dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ==================== MENÚ PRINCIPAL ==================== -->

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:visibility="gone">


        <!-- Encabezado del menú -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">


            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/logo2"
                android:contentDescription="Logo ParkQR"
                android:layout_marginEnd="12dp" />


            <TextView
                android:id="@+id/tvBienvenidaMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bienvenido, Usuario"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/ivMenuIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menú"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- Título -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú principal"
            android:textSize="18sp"
            android:textColor="#555555"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />


        <!-- INGRESO QR -->

        <Button
            android:id="@+id/btnIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 Ingreso QR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />


        <!-- SALIDA QR -->

        <Button
            android:id="@+id/btnSalida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 Salida QR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />


        <!-- VISITANTE -->

        <Button
            android:id="@+id/btnVisitante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 Visitante"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />


        <!-- REGISTRO -->

        <Button
            android:id="@+id/btnRegistroVehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Registro"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />


        <!-- CERRAR SESIÓN -->

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:backgroundTint="#2E7D32"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>
