<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ==================== LOGIN ==================== -->

    <LinearLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:visibility="visible">

        <!-- Encabezado -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#4CAF50"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="180dp"
                android:layout_height="140dp"
                android:src="@drawable/logo1"
                android:contentDescription="Logo ParkQR" />

        </LinearLayout>

        <!-- Formulario -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#F5F5F5">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio de sesión"
                android:textSize="18sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etCedula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cédula"
                android:inputType="number"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"
                android:padding="12dp" />

            <TextView
                android:id="@+id/tvMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="#E53935"
                android:layout_marginTop="10dp" />

            <!-- Opciones inferiores -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvOlvido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Olvidó su contraseña?"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:padding="6dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#999999"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvRegistrarse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrarse"
                    android:textColor="#555555"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="6dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ==================== MENÚ PRINCIPAL ==================== -->

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#F5F5F5"
        android:visibility="gone">

        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="35dp">

            <ImageView
                android:layout_width="105dp"
                android:layout_height="90dp"
                android:src="@drawable/logo2"
                android:contentDescription="Logo ParkQR"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvBienvenidaMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bienvenido, Usuario"
                android:textSize="20sp"
                android:textColor="#333333"
                android:textStyle="bold" />

            <!-- ICONO DE TRES LÍNEAS -->

            <ImageView
                android:id="@+id/ivMenuIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menú"
                android:padding="5dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- TÍTULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menú principal"
            android:textSize="24sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="35dp" />

        <!-- INGRESO QR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/icono1"
                android:background="#00B82E"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="15dp"
                android:contentDescription="Vehículo" />

            <Button
                android:id="@+id/btnIngreso"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Ingreso de vehículo (escáner QR)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00B82E"
                android:padding="5dp" />

        </LinearLayout>

        <!-- SALIDA QR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/icono1"
                android:background="#00B82E"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="15dp"
                android:contentDescription="Vehículo" />

            <Button
                android:id="@+id/btnSalida"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Salida de vehículo (escáner QR)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00B82E"
                android:padding="5dp" />

        </LinearLayout>

        <!-- VEHÍCULO VISITANTE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="35dp">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/icono1"
                android:background="#00B82E"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="15dp"
                android:contentDescription="Vehículo" />

            <Button
                android:id="@+id/btnVisitante"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Vehículo visitante"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00B82E"
                android:padding="5dp" />

        </LinearLayout>

        <!-- CERRAR SESIÓN -->

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Cerrar sesión"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#087D28" />

    </LinearLayout>

</LinearLayout>
